{
  "name": "@thefutureissolo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "kosong remote API: email-code authentication and private per-user document sync.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply kosong --local",
    "migrate:remote": "wrangler d1 migrations apply kosong --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
