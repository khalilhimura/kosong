{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kosong-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",

  "observability": {
    "enabled": true
  },

  // The address the CLI ships pointing at. A workers.dev subdomain would work
  // but ties the service to one account's naming; this can move.
  "routes": [
    {
      "pattern": "api.kosong.thefutureissolo.com",
      "custom_domain": true
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // Sending identity for verification emails. Not a secret.
    "EMAIL_FROM": "kosong <login@thefutureissolo.com>",
    // Turnstile is off until a sending domain and site key exist. When on,
    // TURNSTILE_SECRET must also be set.
    "TURNSTILE_ENABLED": "false"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosong",
      // The real database on the Himura account. Not a secret — reaching it
      // still requires Cloudflare credentials, which kosong never holds.
      //
      // Changing this id also re-keys the *local* miniflare database, which
      // then starts empty and unmigrated. `wrangler dev` will look healthy —
      // /ready only runs `SELECT 1`, which an empty database answers fine —
      // while every insert fails and every route 500s. Run
      // `npm run migrate:local` after touching this line.
      "database_id": "58869958-b5ba-4bc3-aa19-3c53ab2437f1",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "kosong-documents"
    }
  ]

  // Secrets are never in this file. Set them with `wrangler secret put`:
  //   CODE_HMAC_SECRET   hashes verification codes at rest
  //   TOKEN_HMAC_SECRET  signs access tokens and hashes refresh tokens
  //   IP_HASH_SECRET     hashes request IPs before they are stored
  //   RESEND_API_KEY     transactional email
  //   TURNSTILE_SECRET   only when TURNSTILE_ENABLED is "true"
}
